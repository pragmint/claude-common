#compdef skills

_skills() {
  local state

  _arguments \
    '1: :->command' \
    '*: :->args'

  case $state in
    command)
      local -a commands
      commands=(
        'link:fzf single-select an unlinked item to link'
        'unlink:fzf single-select a linked item to unlink'
        'select:fzf multi-select to set full linked/unlinked state'
        'scrape:find and copy .claude resources from a folder into repo'
        'ls:show current link status of all resources'
        'list:show current link status of all resources'
        'install:add skills to ~/.local/bin'
        'uninstall:remove skills from ~/.local/bin'
      )
      _describe 'command' commands
      ;;
    args)
      case $words[2] in
        link|unlink)
          _arguments \
            '(-a --all)'{-a,--all}'[process all items without prompting]'
          ;;
      esac
      ;;
  esac
}

_skills "$@"
